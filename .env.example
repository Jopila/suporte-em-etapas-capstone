# Copie para .env.local e preencha apenas no seu computador.
GROQ_API_KEY=
# O modelo roda no Groq. Não é necessária chave da OpenAI.
GROQ_MODEL=openai/gpt-oss-120b
# json_schema para modelos compatíveis; json_object para outros modelos.
GROQ_RESPONSE_FORMAT=json_schema
GROQ_TIMEOUT_MS=25000
GROQ_MAX_RETRIES=2
PIPELINE_TIMEOUT_MS=120000
